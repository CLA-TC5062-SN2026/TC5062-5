# Copia este archivo como .env (el .env no se versiona).

# URL base del API que usa el frontend. Con /api/v1 las peticiones van al mismo origen
# y Vite las reenvía al backend (en producción lo hace Caddy).
VITE_API_URL=/api/v1

# Solo para el servidor de desarrollo: a dónde reenvía Vite las peticiones de /api/v1.
VITE_BACKEND_URL=http://127.0.0.1:8000
