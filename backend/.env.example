# Copia este archivo como .env y ajusta los valores (el archivo .env no se versiona).

# Ruta del archivo SQLite creado con db/esquema_bd.sql (python scripts/init_db.py)
DATABASE_PATH=./reportaya.db

# Servidor
HOST=127.0.0.1
PORT=8000
API_PREFIX=/api/v1

# Zona horaria del condominio: la BD guarda UTC y la API responde en esta zona (SRS 1.3)
TIMEZONE=America/Mexico_City

# Carpeta donde se guardan las fotos y videos de los reportes
UPLOAD_DIR=./uploads
MAX_FOTO_MB=10
MAX_VIDEO_MB=50

# Autenticación JWT. Genere su propio secreto (no use este valor):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambie-este-valor-por-uno-aleatorio-de-al-menos-32-caracteres
# Minutos de vigencia del token (RNF-06: 30 min)
JWT_EXPIRATION=30

# Correo (RF-11, RF-14). "simulado": no se envía a internet; cada correo queda como .txt en CORREO_BANDEJA_DIR,
# incluidos los enlaces de activación y recuperación de contraseña. "smtp": envío real con los datos SMTP_*.
CORREO_MODO=simulado
# Solo con CORREO_MODO=smtp (ejemplo Gmail: smtp.gmail.com, 587, starttls y una contraseña de aplicación)
SMTP_HOST=
SMTP_PUERTO=587
SMTP_SEGURIDAD=starttls
SMTP_USUARIO=
SMTP_CONTRASENA=
SMTP_REMITENTE=ReportaYa <avisos@su-condominio.mx>
CORREO_BANDEJA_DIR=./correos
# 1 = simular que el servicio de correo no responde (RF-11-AC-4: 3 intentos cada 10 min y luego «Fallido»)
CORREO_SIMULAR_FALLA=0
CORREO_REINTENTO_MINUTOS=10
CORREO_REVISION_SEGUNDOS=60
# URL pública del frontend, para los enlaces que van en los correos
FRONTEND_URL=http://localhost:5173

# Almacén de fotos y videos (RNF-08): "local" (UPLOAD_DIR) o "s3" (AWS S3, Cloudflare R2, MinIO)
ALMACEN=local
S3_BUCKET=
S3_PREFIJO=reportaya
# Vacío para AWS; para R2: https://<id-de-cuenta>.r2.cloudflarestorage.com ; para MinIO: http://minio:9000
S3_ENDPOINT_URL=
S3_REGION=
# Credenciales de S3 (las lee boto3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Respaldos (RNF-14): python scripts/respaldo.py crear | listar | restaurar CARPETA
RESPALDO_DIR=./respaldos
RESPALDO_CONSERVAR=14
