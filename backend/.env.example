# Copia este archivo como .env y ajusta los valores (el archivo .env no se versiona).

# Ruta del archivo SQLite creado con db/esquema_bd.sql (python scripts/init_db.py)
DATABASE_PATH=./reportaya.db

# Servidor
HOST=127.0.0.1
PORT=8000
API_PREFIX=/api/v1

# Zona horaria del condominio: la BD guarda UTC y la API responde en esta zona (SRS 1.3)
TIMEZONE=America/Mexico_City

# Carpeta donde se guardan las fotos y videos de los reportes
UPLOAD_DIR=./uploads
MAX_FOTO_MB=10
MAX_VIDEO_MB=50

# Autenticación JWT. Genere su propio secreto (no use este valor):
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambie-este-valor-por-uno-aleatorio-de-al-menos-32-caracteres
# Minutos de vigencia del token (RNF-06: 30 min)
JWT_EXPIRATION=30
