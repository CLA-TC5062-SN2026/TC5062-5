{
  "info": {
    "name": "ReportaYa - Autenticación (S05-S06-A2)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Flujo del video: register -> login -> me -> ruta protegida con token -> sin token -> rol incorrecto. Requiere el servidor en marcha con la BD de --reset --demo."
  },
  "auth": {
    "type": "noauth"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api/v1"
    },
    {
      "key": "unidadId",
      "value": "1038cb37-070d-5300-9eff-121e6825be4a"
    },
    {
      "key": "correo",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tokenMantenimiento",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 POST register",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Laura Ramírez\",\n  \"correo\": \"{{correo}}\",\n  \"password\": \"Secreta123\",\n  \"unidadId\": \"{{unidadId}}\",\n  \"ocupacion\": \"Propietario\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Correo nuevo en cada corrida, para poder repetir la toma sin reiniciar la BD",
              "pm.collectionVariables.set('correo', 'laura' + Date.now() + '@example.com');"
            ]
          }
        }
      ]
    },
    {
      "name": "2 POST login",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"correo\": \"{{correo}}\",\n  \"password\": \"Secreta123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ]
          }
        }
      ]
    },
    {
      "name": "3 GET me",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "me"
          ]
        }
      },
      "event": []
    },
    {
      "name": "4 GET categories (con token)",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/categories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "categories"
          ]
        }
      },
      "event": []
    },
    {
      "name": "5 GET categories (sin token)",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/categories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "categories"
          ]
        }
      },
      "event": []
    },
    {
      "name": "6 GET categories (rol Mantenimiento)",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{tokenMantenimiento}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/categories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "categories"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Obtiene en segundo plano el token de un usuario con rol Mantenimiento (no autorizado para /categories)",
              "pm.sendRequest({url: pm.collectionVariables.get('baseUrl') + '/auth/login', method: 'POST',",
              "  header: {'Content-Type': 'application/json'},",
              "  body: {mode: 'raw', raw: JSON.stringify({correo: 'mantenimiento@reportaya.demo', password: 'Demo1234!'})}",
              "}, (err, res) => pm.collectionVariables.set('tokenMantenimiento', res.json().token));"
            ]
          }
        }
      ]
    }
  ]
}