# Copie este archivo como .env y ajuste los valores (el archivo .env no se versiona).
# Las variables con prefijo VITE_ se incrustan en el código del navegador: nunca ponga secretos en ellas.

# URL base del API del backend (incluye el prefijo /api/v1 de backend/.env).
# - Ruta relativa (recomendado): el navegador llama al mismo origen que sirve la app. En desarrollo la reenvía
#   el proxy de Vite y en producción Caddy (AR-5), así que el backend no necesita CORS.
# - URL absoluta (por ejemplo http://127.0.0.1:8000/api/v1): llama directo al backend; requiere habilitar CORS en FastAPI.
VITE_API_URL=/api/v1

# Solo para `npm run dev`: a dónde reenvía el proxy de Vite las rutas /api y /health (HOST y PORT de backend/.env).
# No lleva prefijo VITE_, así que no llega al navegador.
API_PROXY_TARGET=http://127.0.0.1:8000
